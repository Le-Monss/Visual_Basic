Imports System
Imports System.Collections.Generic

Module Program
    Sub Main(args As String())
        Console.WriteLine("Kies een race:")
        Console.WriteLine("1. Formule 1")
        Console.WriteLine("2. Rally")
        Dim raceKeuze = LeesGetal("Keuze: ", 1, 2)

        Dim beschikbareVoertuigen As New List(Of Voertuig) From {
            New Formula1("Max", 300, 50, 8),
            New Formula1("Lando", 290, 50, 6),
            New Sportwagen("Porsche", 260, 50, 5),
            New Sportwagen("Ferrari", 270, 50, 8)
        }

        Dim aantalSpelers = LeesGetal("Hoeveel spelers? (2-4): ", 2, beschikbareVoertuigen.Count)
        Dim deelnemers As New List(Of Voertuig)

        For speler As Integer = 1 To aantalSpelers
            Console.Write($"Naam van speler {speler}: ")
            Dim naam = Console.ReadLine()
            If String.IsNullOrWhiteSpace(naam) Then naam = $"Speler {speler}"

            Console.WriteLine("Kies een racer:")
            For index As Integer = 0 To beschikbareVoertuigen.Count - 1
                Console.WriteLine($"{index + 1}. {beschikbareVoertuigen(index).Merk} ({beschikbareVoertuigen(index).GetType().Name})")
            Next

            Dim racerKeuze = LeesGetal("Keuze: ", 1, beschikbareVoertuigen.Count)
            Dim voertuig = beschikbareVoertuigen(racerKeuze - 1)
            voertuig.Bestuurder = naam
            deelnemers.Add(voertuig)
            beschikbareVoertuigen.RemoveAt(racerKeuze - 1)
        Next

        Dim race As Wedstrijd
        If raceKeuze = 1 Then
            Dim bochten = LeesGetal("Hoeveel bochten heeft de baan? (1-20): ", 1, 20)
            Dim baanLengte = LeesGetal("Hoe lang is de baan in km? (10-500): ", 10, 500)
            race = New Formula1Race(bochten, baanLengte)
        Else
            Console.WriteLine("Kies de ondergrond: 1. Asfalt  2. Gravel  3. Modder")
            Dim ondergrondKeuze = LeesGetal("Keuze: ", 1, 3)
            Dim ondergronden As String() = {"asfalt", "gravel", "modder"}
            Dim ondergrond = ondergronden(ondergrondKeuze - 1)
            Dim hoogteverschil = LeesGetal("Hoogteverschil in meters? (0-10): ", 0, 10)
            Dim baanLengte = LeesGetal("Hoe lang is de baan in km? (10-500): ", 10, 500)
            race = New RallyRace(ondergrond, hoogteverschil, baanLengte)
        End If

        For Each voertuig In deelnemers
            race.VoegDeelnemerToe(voertuig)
        Next

        race.Start()
        race.ToonUitslag()
    End Sub

    Private Function LeesGetal(vraag As String, minimum As Integer, maximum As Integer) As Integer
        Dim waarde As Integer
        Do
            Console.Write(vraag)
            If Integer.TryParse(Console.ReadLine(), waarde) AndAlso waarde >= minimum AndAlso waarde <= maximum Then
                Return waarde
            End If
            Console.WriteLine($"Kies een getal van {minimum} tot en met {maximum}.")
        Loop
    End Function
End Module

Public MustInherit Class Voertuig
    Private _brandstof As Double
    Private _startBrandstof As Double
    Private _snelheid As Integer
    Private _afstand As Double
    Private _gestopt As Boolean
    Private _afgerond As Boolean

    Protected Sub New(merk As String, maxSnelheid As Integer, brandstof As Double)
        Me.Merk = merk
        Me.MaxSnelheid = maxSnelheid
        _brandstof = brandstof
        _startBrandstof = brandstof
    End Sub

    Public ReadOnly Property Merk As String
    Public ReadOnly Property MaxSnelheid As Integer
    Public Property Bestuurder As String
    Public ReadOnly Property Snelheid As Integer
        Get
            Return _snelheid
        End Get
    End Property
    Public ReadOnly Property Brandstof As Double
        Get
            Return _brandstof
        End Get
    End Property
    Public ReadOnly Property Afstand As Double
        Get
            Return _afstand
        End Get
    End Property
    Public ReadOnly Property Gestopt As Boolean
        Get
            Return _gestopt
        End Get
    End Property
    Public ReadOnly Property Afgerond As Boolean
        Get
            Return _afgerond
        End Get
    End Property
    Public Overridable ReadOnly Property Acceleratie As Integer
        Get
            Return 10
        End Get
    End Property
    Public Overridable ReadOnly Property VerbruikPerKm As Double
        Get
            Return 0.25
        End Get
    End Property

    Public Overridable Sub Versnel(stap As Integer)
        _snelheid = Math.Min(MaxSnelheid, _snelheid + stap)
    End Sub

    Public Sub Vertraag(doelSnelheid As Integer)
        _snelheid = Math.Max(0, Math.Min(_snelheid, doelSnelheid))
    End Sub

    Public Function Tanken() As Double
        Dim toegevoegd = _startBrandstof - _brandstof
        _brandstof = _startBrandstof
        Return toegevoegd
    End Function

    Public Sub Stoppen()
        _gestopt = True
        _snelheid = 0
    End Sub

    Public Sub MarkeerAlsKlaar()
        _afgerond = True
    End Sub

    Public Overridable Function Rijd(gevraagdeSnelheid As Integer, bochtLimiet As Integer) As String
        If _brandstof <= 0 Then Return "De tank is leeg. Tank eerst bij."

        If gevraagdeSnelheid < _snelheid Then
            Vertraag(gevraagdeSnelheid)
        Else
            Versnel(Math.Min(Acceleratie, gevraagdeSnelheid - _snelheid))
        End If

        Dim afgelegd = _snelheid / 10.0
        Dim verbruik = afgelegd * (_snelheid / 100.0) * VerbruikPerKm
        If _snelheid > bochtLimiet Then
            verbruik = verbruik * 2 + 5
            _brandstof = Math.Max(0, _brandstof - verbruik)
            _snelheid = 0
            Return $"{Merk} vliegt uit de bocht, verliest de beurt en verbruikt extra brandstof ({verbruik:F1} L)."
        End If

        If verbruik > _brandstof Then Return "Niet genoeg brandstof om zo ver te rijden. Tank eerst bij."

        _brandstof -= verbruik
        _afstand += afgelegd
        Return $"Rijdt {afgelegt:F1} km. Brandstofverbruik: {verbruik:F1} L."
    End Function

    Public Sub Reset()
        _brandstof = _startBrandstof
        _snelheid = 0
        _afstand = 0
        _gestopt = False
        _afgerond = False
    End Sub

    Public Function ToonInfo() As String
        Dim bereik = _brandstof / VerbruikPerKm
        Return $"{Merk}: {Snelheid} km/u, brandstof {Brandstof:F1} L, geschat bereik bij 100 km/u: {bereik:F0} km"
    End Function
End Class

Public Class Formula1
    Inherits Voertuig

    Private ReadOnly _downforce As Integer

    Public Sub New(merk As String, maxSnelheid As Integer, brandstof As Double, downforce As Integer)
        MyBase.New(merk, maxSnelheid, brandstof)
        _downforce = downforce
    End Sub

    Public Overrides ReadOnly Property Acceleratie As Integer
        Get
            Return 25 + _downforce
        End Get
    End Property

    Public Overrides ReadOnly Property VerbruikPerKm As Double
        Get
            Return 0.3
        End Get
    End Property
End Class

Public Class Sportwagen
    Inherits Voertuig

    Private ReadOnly _turbo As Integer

    Public Sub New(merk As String, maxSnelheid As Integer, brandstof As Double, turbo As Integer)
        MyBase.New(merk, maxSnelheid, brandstof)
        _turbo = turbo
    End Sub

    Public Overrides ReadOnly Property Acceleratie As Integer
        Get
            Return 18 + _turbo
        End Get
    End Property

    Public Overrides ReadOnly Property VerbruikPerKm As Double
        Get
            Return 0.2
        End Get
    End Property
End Class

Public MustInherit Class Wedstrijd
    Protected ReadOnly Deelnemers As New List(Of Voertuig)
    Private _winnaar As Voertuig

    Protected Sub New(naam As String, baanLengte As Integer)
        Me.Naam = naam
        Me.BaanLengte = baanLengte
        Datum = DateTime.Now
    End Sub

    Public ReadOnly Property Naam As String
    Public ReadOnly Property Datum As DateTime
    Public ReadOnly Property BaanLengte As Integer
    Protected MustOverride ReadOnly Property VeiligeBochtSnelheid As Integer
    Public MustOverride Sub Start()

    Public Sub VoegDeelnemerToe(voertuig As Voertuig)
        If voertuig IsNot Nothing Then Deelnemers.Add(voertuig)
    End Sub

    Protected Sub SpeelRace()
        If Deelnemers.Count = 0 Then
            Console.WriteLine("Er zijn geen racers.")
            Return
        End If

        For Each voertuig In Deelnemers
            voertuig.Reset()
        Next

        Dim raceBezig As Boolean = True
        While raceBezig
            raceBezig = False
            For Each voertuig In Deelnemers
                If voertuig.Gestopt OrElse voertuig.Afgerond Then Continue For
                raceBezig = True

                Console.WriteLine()
                Console.WriteLine($"Beurt van {voertuig.Bestuurder} met {voertuig.Merk}")
                Console.WriteLine($"Afstand: {voertuig.Afstand:F1}/{BaanLengte} km | Snelheid: {voertuig.Snelheid} km/u | Brandstof: {voertuig.Brandstof:F1} L")
                Console.WriteLine("1. Rijden  2. Tanken  3. Stoppen en opgeven  4. Vertragen")
                Dim actie = LeesGetal("Kies actie: ", 1, 4)

                Select Case actie
                    Case 1
                        Dim snelheid = LeesGetal($"Gewenste snelheid (20-{voertuig.MaxSnelheid} km/u): ", 20, voertuig.MaxSnelheid)
                        Console.WriteLine(voertuig.Rijd(snelheid, VeiligeBochtSnelheid))
                    Case 2
                        Console.WriteLine($"Bijgetankt: {voertuig.Tanken():F1} L.")
                    Case 3
                        voertuig.Stoppen()
                        Console.WriteLine($"{voertuig.Bestuurder} stapt uit de race.")
                    Case 4
                        Dim nieuweSnelheid = LeesGetal($"Kies snelheid (0-{voertuig.Snelheid} km/u): ", 0, voertuig.Snelheid)
                        voertuig.Vertraag(nieuweSnelheid)
                        Console.WriteLine($"Snelheid verlaagd naar {voertuig.Snelheid} km/u.")
                End Select

                If Not voertuig.Gestopt AndAlso voertuig.Afstand >= BaanLengte Then
                    voertuig.MarkeerAlsKlaar()
                    If _winnaar Is Nothing Then _winnaar = voertuig
                    Console.WriteLine($"{voertuig.Bestuurder} heeft de finish bereikt!")
                End If
            Next
        End While
    End Sub

    Private Function LeesGetal(vraag As String, minimum As Integer, maximum As Integer) As Integer
        Dim waarde As Integer
        Do
            Console.Write(vraag)
            If Integer.TryParse(Console.ReadLine(), waarde) AndAlso waarde >= minimum AndAlso waarde <= maximum Then
                Return waarde
            End If
            Console.WriteLine($"Kies een getal van {minimum} tot en met {maximum}.")
        Loop
    End Function

    Public Sub ToonUitslag()
        If _winnaar Is Nothing Then
            Console.WriteLine("Geen winnaar: niemand heeft de finish gehaald.")
        Else
            Console.WriteLine($"Winnaar van {Naam}: {_winnaar.Bestuurder} met {_winnaar.Merk}!")
        End If

        For Each voertuig In Deelnemers
            Console.WriteLine($"{voertuig.Bestuurder}: {voertuig.Afstand:F1} km, {voertuig.Brandstof:F1} L brandstof")
        Next
    End Sub
End Class

Public Class Formula1Race
    Inherits Wedstrijd

    Private ReadOnly _bochten As Integer

    Public Sub New(bochten As Integer, baanLengte As Integer)
        MyBase.New("Formule 1", baanLengte)
        _bochten = bochten
    End Sub

    Protected Overrides ReadOnly Property VeiligeBochtSnelheid As Integer
        Get
            Return Math.Max(80, 240 - _bochten * 5)
        End Get
    End Property

    Public Overrides Sub Start()
        Console.WriteLine($"De Formule 1-race start met {_bochten} bochten. Veilige bochtsnelheid: {VeiligeBochtSnelheid} km/u.")
        SpeelRace()
    End Sub
End Class

Public Class RallyRace
    Inherits Wedstrijd

    Private ReadOnly _ondergrond As String
    Private ReadOnly _hoogteverschil As Integer

    Public Sub New(ondergrond As String, hoogteverschil As Integer, baanLengte As Integer)
        MyBase.New("Rally", baanLengte)
        _ondergrond = ondergrond
        _hoogteverschil = hoogteverschil
    End Sub

    Protected Overrides ReadOnly Property VeiligeBochtSnelheid As Integer
        Get
            Dim limiet As Integer = 150
            If _ondergrond = "gravel" Then limiet = 120
            If _ondergrond = "modder" Then limiet = 90
            Return Math.Max(50, limiet - _hoogteverschil * 2)
        End Get
    End Property

    Public Overrides Sub Start()
        Console.WriteLine($"De rally start op {_ondergrond} met {_hoogteverschil} meter hoogteverschil. Veilige bochtsnelheid: {VeiligeBochtSnelheid} km/u.")
        SpeelRace()
    End Sub
End Class
