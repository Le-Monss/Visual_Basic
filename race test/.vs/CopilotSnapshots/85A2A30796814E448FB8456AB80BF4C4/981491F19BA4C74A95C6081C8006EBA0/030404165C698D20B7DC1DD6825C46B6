Imports System
Imports System.Collections.Generic

Module Program
    Sub Main(args As String())
        Dim voertuigen As New List(Of Voertuig) From {
            New Formula1("Max", 300, 10, 8),
            New Formula1("Lando", 290, 10, 6),
            New Sportwagen("Porsche", 260, 10, 5),
            New Sportwagen("Ferrari", 270, 10, 8)
        }

        Dim formuleRace As New Formula1Race(8)
        Dim rallyRace As New RallyRace("gravel", 20)
        For Each voertuig In voertuigen
            formuleRace.VoegDeelnemerToe(voertuig)
            rallyRace.VoegDeelnemerToe(voertuig)
        Next

        Dim keuze As String
        Do
            Console.WriteLine()
            Console.WriteLine("1. Toon voertuigen")
            Console.WriteLine("2. Start Formule 1-race")
            Console.WriteLine("3. Start rally")
            Console.WriteLine("0. Afsluiten")
            Console.Write("Kies: ")
            keuze = Console.ReadLine()

            Select Case keuze
                Case "1"
                    For Each voertuig In voertuigen
                        Console.WriteLine(voertuig.ToonInfo())
                    Next
                Case "2"
                    formuleRace.Start()
                    formuleRace.ToonUitslag()
                Case "3"
                    rallyRace.Start()
                    rallyRace.ToonUitslag()
                Case "0"
                    Console.WriteLine("Tot ziens!")
                Case Else
                    Console.WriteLine("Ongeldige keuze.")
            End Select
        Loop Until keuze = "0"
    End Sub
End Module

Public MustInherit Class Voertuig
    Private _brandstof As Double
    Private _startBrandstof As Double
    Private _snelheid As Integer
    Private _afstand As Double

    Protected Sub New(merk As String, maxSnelheid As Integer, brandstof As Double)
        Me.Merk = merk
        Me.MaxSnelheid = maxSnelheid
        _brandstof = brandstof
        _startBrandstof = brandstof
    End Sub

    Public ReadOnly Property Merk As String
    Public ReadOnly Property MaxSnelheid As Integer
    Public ReadOnly Property Snelheid As Integer
        Get
            Return _snelheid
        End Get
    End Property
    Public ReadOnly Property Brandstof As Double
        Get
            Return _brandstof
        End Get
    End Property
    Public ReadOnly Property Afstand As Double
        Get
            Return _afstand
        End Get
    End Property
    Public Overridable ReadOnly Property Acceleratie As Integer
        Get
            Return 10
        End Get
    End Property

    Public Overridable Sub Versnel(stap As Integer)
        _snelheid = Math.Min(MaxSnelheid, _snelheid + stap)
    End Sub

    Public Sub RemAf(afstand As Integer)
        _snelheid = Math.Max(0, _snelheid - afstand)
    End Sub

    Public Overridable Function Rijd() As Double
        If _brandstof <= 0 Then Return 0

        Versnel(Acceleratie)
        _brandstof -= 1
        Dim afgelegd = _snelheid / 10.0
        _afstand += afgelegd
        Return afgelegd
    End Function

    Public Sub Reset()
        _brandstof = _startBrandstof
        _snelheid = 0
        _afstand = 0
    End Sub

    Public Function ToonInfo() As String
        Return $"{Merk}: {Snelheid} km/u, brandstof {Brandstof:F0}, afstand {Afstand:F1} km"
    End Function
End Class

Public Class Formula1
    Inherits Voertuig

    Private ReadOnly _downforce As Integer

    Public Sub New(merk As String, maxSnelheid As Integer, brandstof As Double, downforce As Integer)
        MyBase.New(merk, maxSnelheid, brandstof)
        _downforce = downforce
    End Sub

    Public Overrides ReadOnly Property Acceleratie As Integer
        Get
            Return 25
        End Get
    End Property

    Public Overrides Sub Versnel(stap As Integer)
        MyBase.Versnel(stap + _downforce)
    End Sub
End Class

Public Class Sportwagen
    Inherits Voertuig

    Private ReadOnly _turbo As Integer

    Public Sub New(merk As String, maxSnelheid As Integer, brandstof As Double, turbo As Integer)
        MyBase.New(merk, maxSnelheid, brandstof)
        _turbo = turbo
    End Sub

    Public Overrides ReadOnly Property Acceleratie As Integer
        Get
            Return 18
        End Get
    End Property

    Public Overrides Sub Versnel(stap As Integer)
        MyBase.Versnel(stap + _turbo)
    End Sub
End Class

Public MustInherit Class Wedstrijd
    Protected ReadOnly Deelnemers As New List(Of Voertuig)
    Private ReadOnly _finishafstand As Double
    Private _winnaar As Voertuig

    Protected Sub New(naam As String, finishafstand As Double)
        Me.Naam = naam
        _finishafstand = finishafstand
        Datum = DateTime.Now
    End Sub

    Public ReadOnly Property Naam As String
    Public ReadOnly Property Datum As DateTime
    Public MustOverride Sub Start()

    Public Sub VoegDeelnemerToe(voertuig As Voertuig)
        If voertuig IsNot Nothing Then Deelnemers.Add(voertuig)
    End Sub

    Protected Sub ResetDeelnemers()
        For Each voertuig In Deelnemers
            voertuig.Reset()
        Next
    End Sub

    Protected Sub RondeStarten(ronde As Integer, remkracht As Integer)
        Console.WriteLine($"Ronde {ronde}")
        For Each voertuig In Deelnemers
            If remkracht > 0 Then voertuig.RemAf(remkracht)
            If voertuig.Rijd() > 0 Then
                Console.WriteLine($"{voertuig.Merk}: {voertuig.Afstand:F1} km")
            Else
                Console.WriteLine($"{voertuig.Merk} heeft geen brandstof meer.")
            End If
        Next
    End Sub

    Protected Function FinishBereikt() As Boolean
        For Each voertuig In Deelnemers
            If voertuig.Afstand >= _finishafstand Then Return True
        Next
        Return False
    End Function

    Public Sub ToonUitslag()
        If Deelnemers.Count = 0 Then
            Console.WriteLine("Er zijn geen deelnemers.")
            Return
        End If

        _winnaar = Deelnemers(0)
        For Each voertuig In Deelnemers
            If voertuig.Afstand > _winnaar.Afstand Then _winnaar = voertuig
        Next
        Console.WriteLine($"Winnaar van {Naam}: {_winnaar.Merk}!")
    End Sub
End Class

Public Class Formula1Race
    Inherits Wedstrijd

    Private ReadOnly _turns As Integer

    Public Sub New(turns As Integer)
        MyBase.New("Formule 1", 50)
        _turns = turns
    End Sub

    Public Overrides Sub Start()
        ResetDeelnemers()
        Console.WriteLine("De Formule 1-race begint!")
        For ronde As Integer = 1 To _turns
            RondeStarten(ronde, 0)
            If FinishBereikt() Then Exit For
        Next
    End Sub
End Class

Public Class RallyRace
    Inherits Wedstrijd

    Private ReadOnly _ondergrond As String
    Private ReadOnly _hoogteverschil As Integer

    Public Sub New(ondergrond As String, hoogteverschil As Integer)
        MyBase.New("Rally", 50)
        _ondergrond = ondergrond
        _hoogteverschil = hoogteverschil
    End Sub

    Public Overrides Sub Start()
        ResetDeelnemers()
        Console.WriteLine($"De rally begint op {_ondergrond} met {_hoogteverschil} meter hoogteverschil!")

        Dim remkracht = _hoogteverschil \ 10
        If _ondergrond.ToLowerInvariant() = "modder" Then remkracht += 5

        For ronde As Integer = 1 To 8
            RondeStarten(ronde, remkracht)
            If FinishBereikt() Then Exit For
        Next
    End Sub
End Class
